      <RadioButton fx:id="bunny" layoutX="312.0" layoutY="192.0" mnemonicParsing="false" text="bunny" />
      <RadioButton fx:id="bird" layoutX="457.0" layoutY="192.0" mnemonicParsing="false" text="bird" />
      <Text fill="#ff4885" layoutX="175.0" layoutY="53.0" strokeType="OUTSIDE" strokeWidth="0.0" text="choose your pet" wrappingWidth="274.33514404296875">
         <font>
            <Font size="29.0" />
         </font>
      </Text>

      <Button layoutX="260.0" layoutY="252.0" mnemonicParsing="false" onAction="#choose" style="-fx-background-color: pink;" text="choose" />
      <TextField fx:id="name" layoutX="226.0" layoutY="120.0" promptText="ex:bunny" />
