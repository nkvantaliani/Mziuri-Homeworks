<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: pink;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <children>
      <TextField fx:id="username" layoutX="225.0" layoutY="174.0" promptText="enter username" />
      <PasswordField fx:id="password" layoutX="225.0" layoutY="219.0" promptText="enter password" />
      <Text layoutX="263.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
         <font>
            <Font size="30.0" />
         </font>
      </Text>
      <Label fx:id="message" alignment="CENTER" layoutX="191.0" layoutY="306.0" prefHeight="54.0" prefWidth="218.0" textAlignment="CENTER" textFill="#84033f" />
      <Button layoutX="277.0" layoutY="262.0" mnemonicParsing="false" onAction="#onLogin" style="-fx-background-color: #AA446A;" text="Login" />
   </children>
</AnchorPane>
